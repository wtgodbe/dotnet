<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <DisallowDotNetFinalVersionKindOverride>true</DisallowDotNetFinalVersionKindOverride>
  </PropertyGroup>

  <PropertyGroup Condition="(('$(TargetOS)' == 'linux' and '$(TargetArchitecture)' == 'x64') or '$(TargetOS)' == 'browser') and '$(EnableDefaultRidSpecificArtifacts)' == 'true'">
    <!--
      We have BuildPass2 legs that have no dependencies on Windows artifacts except for Arcade
      (the Workloads job only depends on the short-stack verticals, including Browser).
      To make sure those jobs don't need to wait for the Windows verticals,
      we'll build all of Arcade with Internal visibility.
    -->
    <EnableDefaultRidSpecificArtifacts></EnableDefaultRidSpecificArtifacts>
    <DefaultArtifactVisibility>Internal</DefaultArtifactVisibility>
  </PropertyGroup>

  <ItemGroup>
    <RepositoryReference Include="source-build-assets" Condition="'$(DotNetBuildSourceOnly)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <BuiltSdkPackage Include="Microsoft.DotNet.Arcade.Sdk" />
    <BuiltSdkPackage Include="Microsoft.DotNet.SharedFramework.Sdk" />
    <BuiltSdkPackage Include="Microsoft.DotNet.CMake.Sdk" />
  </ItemGroup>

</Project>
